{
  "name": "stratal-example-13-rbac",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "generate": "zenstack generate --schema db/schema.zmodel -o db/zenstack",
    "wrangler:types": "wrangler types --strict-vars=false",
    "db:up": "docker compose up -d",
    "db:push": "DATABASE_URL='postgres://stratal:stratal@localhost:6432/stratal_rbac_example' npx zenstack db push --schema db/schema.zmodel",
    "quarry": "quarry",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit"
  },
  "dependencies": {
    "@stratal/framework": "^0.1.0",
    "pg": "^8.23.0",
    "stratal": "^0.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  }
}
