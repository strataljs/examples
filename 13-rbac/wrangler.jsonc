{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stratal-example-13-rbac",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_SECRET": "my-secret-key-change-in-production",
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "placeholder"
    }
  ],
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "placeholder",
      "localConnectionString": "postgres://stratal:stratal@localhost:6433/stratal_rbac_example"
    }
  ]
}
